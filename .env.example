# Copy to .env and edit. Never commit .env.
DATABASE_URL=postgresql+asyncpg://postgres:dev@localhost:5432/lts_timetrack
JWT_SECRET=change-me-to-a-long-random-string
SCHOOL_TZ=UTC
ALLOWED_ORIGINS=["http://localhost:3000"]

# Optional: shared rate limits + fresh-QR cache across uvicorn workers (docker compose up -d redis).
# Leave unset for a single worker / local dev (falls back to per-process memory).
# REDIS_URL=redis://localhost:6379/0

# Used by scripts/seed.py to create the first admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=First Admin
